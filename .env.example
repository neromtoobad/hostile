# Base RPC (the public one works; a private one is faster)
BASE_RPC=https://mainnet.base.org
# Deployer key for script/Deploy.s.sol (fresh wallet, a little ETH on Base). Never commit .env.
PRIVATE_KEY=
# For --verify on BaseScan
ETHERSCAN_API_KEY=
# Optional: keeper wallet for tools/keeper.mjs (fresh wallet, a little ETH on Base for gas).
# Without it the keeper only reports what is due. Never commit .env.
KEEPER_KEY=
# Optional: Base Builder Code for the keeper's transactions (the app uses web/.env: VITE_BUILDER_CODE)
BUILDER_CODE=
